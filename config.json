{
  "title": "Pz的日记",
  "subTitle": "在坚冰还盖着北海的时候我看到了怒放的梅花",
  "avatarUrl": "https://avatars.githubusercontent.com/u/74855623?v=4&size=64",
  "GMEEK_VERSION": "last",
  "needComment": false,
  "script": "<script>\n(function(){\n  var postBody=document.getElementById(\"postBody\");\n  if(!postBody)return;\n  var postTitle=document.querySelector(\".postTitle\");\n  var text=postBody.innerText||\"\";\n  var count=text.replace(/\\s/g,\"\").length;\n  var minutes=Math.ceil(count/400);\n  \n  var issueMatch=window.location.pathname.match(/post\\/(.+)\\.html$/);\n  if(issueMatch){\n    var postListJsonUrl=\"https://raw.githubusercontent.com/Pz0120/pz0120.github.io/main/docs/postList.json\";\n    fetch(postListJsonUrl).then(function(r){return r.json()}).then(function(postList){\n      for(var key in postList){\n        if(postList[key].postUrl===\"post/\"+issueMatch[1]+\".html\"){\n          var createdDate=postList[key].createdDate||\"--\";\n          var sigEl=document.getElementById(\"sigDate\");\n          if(sigEl)sigEl.innerText=createdDate;\n          break;\n        }\n      }\n    }).catch(function(){});}\n  \n  // 1. 滚动揭示\n  var style=document.createElement(\"style\");\n  style.textContent='.reveal{opacity:0;transform:translateY(30px);transition:opacity .8s ease,transform .8s ease;}.reveal.visible{opacity:1;transform:translateY(0);}';\n  document.head.appendChild(style);\n  var elements=postBody.querySelectorAll('p, h2, h3, blockquote, ul, ol, table, img');\n  elements.forEach(function(el,i){el.classList.add('reveal');el.style.transitionDelay=(Math.min(i*0.05,0.5))+'s';});\n  var observer=new IntersectionObserver(function(entries){entries.forEach(function(entry){if(entry.isIntersecting)entry.target.classList.add('visible');});},{threshold:0.1});\n  elements.forEach(function(el){observer.observe(el);});\n  \n  // 2. 动态签名\n  var signature=document.createElement(\"div\");\n  signature.style.cssText=\"margin-top:32px;padding:20px 0;border-top:1px solid #eee;text-align:right;\";\n  signature.innerHTML='<div style=\"font-family:Georgia,serif;font-size:16px;color:#666;font-style:italic;\">—— Pz</div><div style=\"font-size:12px;color:#aaa;margin-top:4px;\">写于 <span id=\"sigDate\">--</span></div>';\n  postBody.appendChild(signature);\n  \n  // 3. 统计信息卡片\n  var startDate=new Date(\"2026-09-08\");\n  var runDays=Math.floor((new Date()-startDate)/(1000*60*60*24));\n  var statsCard=document.createElement(\"div\");\n  statsCard.style.cssText=\"margin:24px 0;padding:16px 20px;background:linear-gradient(135deg,#f5f7fa 0%,#e8ecf1 100%);border-radius:10px;display:flex;justify-content:space-around;align-items:center;flex-wrap:wrap;gap:12px;\";\n  statsCard.innerHTML='<div style=\"text-align:center;flex:1;min-width:80px;\"><div style=\"font-size:20px;font-weight:700;color:#e94560;\" id=\"runDays\">'+runDays+'</div><div style=\"font-size:11px;color:#888;margin-top:2px;\">运行天数</div></div>'\n    +'<div style=\"width:1px;height:30px;background:#ddd;\"></div>'\n    +'<div style=\"text-align:center;flex:1;min-width:80px;\"><div style=\"font-size:20px;font-weight:700;color:#2ecc71;\" id=\"pageViews\">--</div><div style=\"font-size:11px;color:#888;margin-top:2px;\">阅读次数</div></div>'\n    +'<div style=\"width:1px;height:30px;background:#ddd;\"></div>'\n    +'<div style=\"text-align:center;flex:1;min-width:80px;\"><div style=\"font-size:20px;font-weight:700;color:#3498db;\">'+count+'</div><div style=\"font-size:11px;color:#888;margin-top:2px;\">字数</div></div>';\n  postBody.appendChild(statsCard);\n  \n  if(!window.busuanziLoaded){\n    window.busanziLoaded=true;\n    var bszScript=document.createElement(\"script\");\n    bszScript.src=\"//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js\";\n    bszScript.async=true;\n    bszScript.onload=function(){\n      var pv=document.getElementById(\"busuanzi_value_page_pv\");\n      if(pv){\n        varobserver2=setInterval(function(){\n          var val=document.getElementById(\"busuanzi_value_page_pv\");\n          if(val&&val.innerText!==\"...\"){\n            document.getElementById(\"pageViews\").innerText=val.innerText;\n            clearInterval(varobserver2);\n          }\n        },500);\n      }\n    };\n    document.body.appendChild(bszScript);\n  }\n  \n  // 4. 图片灯箱\n  var imgs=postBody.querySelectorAll('img');\n  imgs.forEach(function(img){img.style.cursor=\"pointer\";img.onclick=function(){openLightbox(img.src);}});\n  function openLightbox(src){\n    var overlay=document.createElement(\"div\");\n    overlay.id=\"lightboxOverlay\";\n    overlay.style.cssText=\"position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.9);z-index:9999;display:flex;align-items:center;justify-content:center;cursor:zoom-out;\";\n    overlay.innerHTML='<img src=\"'+src+'\" style=\"max-width:90%;max-height:90%;object-fit:contain;border-radius:4px;\">';\n    overlay.onclick=function(){document.body.removeChild(overlay);};\n    document.body.appendChild(overlay);\n    document.addEventListener(\"keydown\",function esc(e){if(e.key===\"Escape\"){var lb=document.getElementById(\"lightboxOverlay\");if(lb)document.body.removeChild(lb);document.removeEventListener(\"keydown\",esc);}});\n  }\n  \n  var btn=document.createElement(\"div\");\n  btn.innerHTML=\"↑\";\n  btn.title=\"回到顶部\";\n  btn.style.cssText=\"position:fixed;right:24px;bottom:24px;width:44px;height:44px;border-radius:50%;background:#333;color:#fff;font-size:22px;text-align:center;line-height:44px;cursor:pointer;opacity:0;transition:opacity .3s;box-shadow:0 2px 8px rgba(0,0,0,.25);z-index:999;user-select:none;\";\n  btn.onmouseover=function(){btn.style.background=\"#555\"};\n  btn.onmouseout=function(){btn.style.background=\"#333\"};\n  btn.onclick=function(){window.scrollTo({top:0,behavior:\"smooth\"})};\n  document.body.appendChild(btn);\n  window.addEventListener(\"scroll\",function(){btn.style.opacity=window.scrollY>300?\"0.85\":\"0\"});\n})();\n</script>\n"
}