  "script": "<script>\n(function(){\n  var postBody=document.getElementById(\"postBody\");\n  if(!postBody)return;\n  var postTitle=document.querySelector(\".postTitle\");\n  var text=postBody.innerText||\"\";\n  var count=text.replace(/\\s/g,\"\").length;\n  var minutes=Math.ceil(count/400);\n  if(postTitle){\n    var metaDiv=document.createElement(\"div\");\n    metaDiv.style.cssText=\"font-size:13px;color:#999;font-weight:normal;margin-top:10px;padding-bottom:16px;border-bottom:1px solid #eee;\";\n    metaDiv.innerHTML=\"<span id='publishDate'>发布于 --</span><span style='margin:0 12px;'>·</span><span>字数：\"+count+\" 字</span><span style='margin:0 12px;'>·</span><span>阅读：约 \"+minutes+\" 分钟</span>\";\n    postTitle.parentNode.insertBefore(metaDiv,postTitle.nextSibling);\n  }\n  var hitokoto=document.createElement(\"div\");\n  hitokoto.style.cssText=\"font-size:14px;color:#777;margin:24px 0 20px;padding:14px 18px;background:#f9f9f9;border-left:3px solid #ccc;font-style:italic;text-align:center;\";\n  hitokoto.innerText=\"加载中...\";\n  postBody.parentNode.insertBefore(hitokoto,postBody);\n  var issueMatch=window.location.pathname.match(/post\\/(.+)\\.html$/);\n  if(issueMatch){\n    var postListJsonUrl=\"https://raw.githubusercontent.com/Pz0120/pz0120.github.io/main/docs/postList.json\";\n    fetch(postListJsonUrl).then(function(r){return r.json()}).then(function(postList){\n      for(var key in postList){\n        if(postList[key].postUrl===\"post/\"+issueMatch[1]+\".html\"){\n          var createdDate=postList[key].createdDate||\"--\";\n          var el=document.getElementById(\"publishDate\");\n          if(el)el.innerText=\"发布于 \"+createdDate;\n          break;\n        }\n      }\n    }).catch(function(){});\n  }\n  fetch(\"https://v1.hitokoto.cn/?c=d&c=i&encode=json\").then(function(r){return r.json()}).then(function(d){hitokoto.innerHTML=\"「 \"+d.hitokoto+\" 」<br><span style='font-size:12px;color:#aaa;'>\"+(d.from?\"—— \"+d.from:\"\")+\"</span>\"}).catch(function(){hitokoto.innerHTML=\"「 在坚冰还盖着北海的时候，我看到了怒放的梅花 」\"});\n  function initMusicPlayer(){\n    var musicDiv=document.createElement(\"div\");\n    musicDiv.style.cssText=\"margin:24px 0;\";\n    var meting=document.createElement(\"meting-js\");\n    meting.setAttribute(\"server\",\"netease\");\n    meting.setAttribute(\"type\",\"playlist\");\n    meting.setAttribute(\"id\",\"749947383\");\n    meting.setAttribute(\"theme\",\"#2980b9\");\n    meting.setAttribute(\"preload\",\"auto\");\n    meting.setAttribute(\"order\",\"list\");\n    musicDiv.appendChild(meting);\n    postBody.parentNode.insertBefore(musicDiv,postBody.nextSibling);\n  }\n  if(!window.metingJsLoaded){\n    window.metingJsLoaded=true;\n    var link=document.createElement(\"link\");\n    link.rel=\"stylesheet\";\n    link.href=\"https://cdn.jsdelivr.net/npm/aplayer/dist/APlayer.min.css\";\n    document.head.appendChild(link);\n    var script1=document.createElement(\"script\");\n    script1.src=\"https://cdn.jsdelivr.net/npm/aplayer/dist/APlayer.min.js\";\n    script1.onload=function(){\n      var script2=document.createElement(\"script\");\n      script2.src=\"https://cdn.jsdelivr.net/npm/meting@2/dist/Meting.min.js\";\n      script2.onload=initMusicPlayer;\n      document.body.appendChild(script2);\n    };\n    document.body.appendChild(script1);\n  }else{\n    initMusicPlayer();\n  }\n  var btn=document.createElement(\"div\");\n  btn.innerHTML=\"↑\";\n  btn.title=\"回到顶部\";\n  btn.style.cssText=\"position:fixed;right:24px;bottom:24px;width:44px;height:44px;border-radius:50%;background:#333;color:#fff;font-size:22px;text-align:center;line-height:44px;cursor:pointer;opacity:0;transition:opacity .3s;box-shadow:0 2px 8px rgba(0,0,0,.25);z-index:999;user-select:none;\";\n  btn.onmouseover=function(){btn.style.background=\"#555\"};\n  btn.onmouseout=function(){btn.style.background=\"#333\"};\n  btn.onclick=function(){window.scrollTo({top:0,behavior:\"smooth\"})};\n  document.body.appendChild(btn);\n  window.addEventListener(\"scroll\",function(){btn.style.opacity=window.scrollY>300?\"0.85\":\"0\"});\n})();\n</script>\n"
