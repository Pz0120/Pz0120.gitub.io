{
  "title": "Pz的日记",
  "subTitle": "在坚冰还盖着北海的时候我看到了怒放的梅花",
  "avatarUrl": "https://avatars.githubusercontent.com/u/74855623?v=4&size=64",
  "GMEEK_VERSION": "last",
  "needComment": false,
  "script": "<script>\n(function(){\n  var postBody=document.getElementById(\"postBody\");\n  if(!postBody)return;\n  var postTitle=document.querySelector(\".postTitle\");\n  var text=postBody.innerText||\"\";\n  var count=text.replace(/\\s/g,\"\").length;\n  var minutes=Math.ceil(count/400);\n  if(postTitle){\n    var metaDiv=document.createElement(\"div\");\n    metaDiv.style.cssText=\"font-size:13px;color:#999;font-weight:normal;margin-top:10px;padding-bottom:16px;border-bottom:1px solid #eee;\";\n    metaDiv.innerHTML=\"<span id='publishDate'>发布于 --</span><span style='margin:0 12px;'>·</span><span>字数：\"+count+\" 字</span><span style='margin:0 12px;'>·</span><span>阅读：约 \"+minutes+\" 分钟</span>\";\n    postTitle.parentNode.insertBefore(metaDiv,postTitle.nextSibling);\n  }\n  var hitokoto=document.createElement(\"div\");\n  hitokoto.style.cssText=\"font-size:14px;color:#777;margin:24px 0 20px;padding:14px 18px;background:#f9f9f9;border-left:3px solid #ccc;font-style:italic;text-align:center;\";\n  hitokoto.innerText=\"加载中...\";\n  postBody.parentNode.insertBefore(hitokoto,postBody);\n  var issueMatch=window.location.pathname.match(/post\\/(.+)\\.html$/);\n  if(issueMatch){\n    var postListJsonUrl=\"https://raw.githubusercontent.com/Pz0120/pz0120.github.io/main/docs/postList.json\";\n    fetch(postListJsonUrl).then(function(r){return r.json()}).then(function(postList){\n      for(var key in postList){\n        if(postList[key].postUrl===\"post/\"+issueMatch[1]+\".html\"){\n          var createdDate=postList[key].createdDate||\"--\";\n          var el=document.getElementById(\"publishDate\");\n          if(el)el.innerText=\"发布于 \"+createdDate;\n          break;\n        }\n      }\n    }).catch(function(){});\n  }\n  fetch(\"https://v1.hitokoto.cn/?c=d&c=i&encode=json\").then(function(r){return r.json()}).then(function(d){hitokoto.innerHTML=\"「 \"+d.hitokoto+\" 」<br><span style='font-size:12px;color:#aaa;'>\"+(d.from?\"—— \"+d.from:\"\")+\"</span>\"}).catch(function(){hitokoto.innerHTML=\"「 在坚冰还盖着北海的时候，我看到了怒放的梅花 」\"});\n  var playlist=[\n    {title:\"曲一\",artist:\"歌手一\",src:\"https://pz0120.github.io/docs/music/song1.mp3\",cover:\"https://pz0120.github.io/docs/music/cover1.jpg\"},\n    {title:\"曲二\",artist:\"歌手二\",src:\"https://pz0120.github.io/docs/music/song2.mp3\",cover:\"https://pz0120.github.io/docs/music/cover2.jpg\"}\n  ];\n  var currentTrack=0;\n  var isPlaying=false;\n  var audio=new Audio();\n  audio.preload=\"metadata\";\n  var player=document.createElement(\"div\");\n  player.id=\"musicPlayer\";\n  player.style.cssText=\"margin:24px 0;border-radius:12px;overflow:hidden;background:linear-gradient(135deg,#1a1a2e 0%,#16213e 50%,#0f3460 100%);box-shadow:0 4px 20px rgba(0,0,0,.3);\";\n  function renderPlayer(){\n    var track=playlist[currentTrack];\n    player.innerHTML='<div style=\"display:flex;align-items:center;padding:20px;gap:16px;\">'\n      +'<div style=\"width:64px;height:64px;border-radius:8px;overflow:hidden;flex-shrink:0;background:#333;\">'\n      +'<img src=\"'+track.cover+'\" style=\"width:100%;height:100%;object-fit:cover;\" onerror=\"this.style.display=\\'none\\'\">'\n      +'</div>'\n      +'<div style=\"flex:1;min-width:0;\">'\n      +'<div style=\"color:#fff;font-size:15px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\">'+track.title+'</div>'\n      +'<div style=\"color:#aaa;font-size:12px;margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\">'+track.artist+'</div>'\n      +'<div style=\"display:flex;align-items:center;margin-top:10px;gap:12px;\">'\n      +'<span id=\"currentTime\" style=\"color:#888;font-size:11px;min-width:35px;\">0:00</span>'\n      +'<div id=\"progressBar\" style=\"flex:1;height:4px;background:rgba(255,255,255,.15);border-radius:2px;cursor:pointer;\">'\n      +'<div id=\"progress\" style=\"height:100%;width:0%;background:linear-gradient(90deg,#e94560,#ff6b6b);border-radius:2px;transition:width .1s;\"></div>'\n      +'</div>'\n      +'<span id=\"duration\" style=\"color:#888;font-size:11px;min-width:35px;\">0:00</span>'\n      +'</div>'\n      +'</div>'\n      +'<div style=\"display:flex;align-items:center;gap:8px;flex-shrink:0;\">'\n      +'<button id=\"prevBtn\" style=\"width:36px;height:36px;border:none;border-radius:50%;background:rgba(255,255,255,.1);color:#fff;font-size:14px;cursor:pointer;\">‹</button>'\n      +'<button id=\"playBtn\" style=\"width:44px;height:44px;border:none;border-radius:50%;background:linear-gradient(135deg,#e94560,#ff6b6b);color:#fff;font-size:18px;cursor:pointer;box-shadow:0 2px 10px rgba(233,69,96,.4);\">▶</button>'\n      +'<button id=\"nextBtn\" style=\"width:36px;height:36px;border:none;border-radius:50%;background:rgba(255,255,255,.1);color:#fff;font-size:14px;cursor:pointer;\">›</button>'\n      +'</div>'\n      +'</div>';\n    document.getElementById(\"playBtn\").onclick=togglePlay;\n    document.getElementById(\"prevBtn\").onclick=function(){prevTrack();};\n    document.getElementById(\"nextBtn\").onclick=function(){nextTrack();};\n    document.getElementById(\"progressBar\").onclick=seekAudio;\n  }\n  function togglePlay(){\n    if(isPlaying){audio.pause();isPlaying=false;document.getElementById(\"playBtn\").innerHTML=\"▶\";}\n    else{audio.play().catch(function(){});isPlaying=true;document.getElementById(\"playBtn\").innerHTML=\"❚❚\";}\n  }\n  function prevTrack(){\n    currentTrack=(currentTrack-1+playlist.length)%playlist.length;\n    loadTrack();if(isPlaying)audio.play().catch(function(){});\n  }\n  function nextTrack(){\n    currentTrack=(currentTrack+1)%playlist.length;\n    loadTrack();if(isPlaying)audio.play().catch(function(){});\n  }\n  function loadTrack(){\n    var track=playlist[currentTrack];\n    audio.src=track.src;\n    audio.load();\n    renderPlayer();\n    document.getElementById(\"playBtn\").innerHTML=\"▶\";\n    isPlaying=false;\n  }\n  function seekAudio(e){\n    var bar=e.currentTarget;\n    var rect=bar.getBoundingClientRect();\n    var percent=(e.clientX-rect.left)/rect.width;\n    if(audio.duration)audio.currentTime=percent*audio.duration;\n  }\n  audio.addEventListener(\"timeupdate\",function(){\n    if(audio.duration){\n      var percent=(audio.currentTime/audio.duration*100);\n      var p=document.getElementById(\"progress\");\n      if(p)p.style.width=percent+\"%\";\n      var ct=document.getElementById(\"currentTime\");\n      if(ct)ct.innerText=formatTime(audio.currentTime);\n    }\n  });\n  audio.addEventListener(\"loadedmetadata\",function(){\n    var d=document.getElementById(\"duration\");\n    if(d)d.innerText=formatTime(audio.duration);\n  });\n  audio.addEventListener(\"ended\",function(){nextTrack();});\n  function formatTime(s){\n    if(!s||isNaN(s))return\"0:00\";\n    var m=Math.floor(s/60);var sec=Math.floor(s%60);\n    return m+\":\"+(sec<10?\"0\":\"\")+sec;\n  }\n  renderPlayer();\n  postBody.parentNode.insertBefore(player,postBody.nextSibling);\n  var btn=document.createElement(\"div\");\n  btn.innerHTML=\"↑\";\n  btn.title=\"回到顶部\";\n  btn.style.cssText=\"position:fixed;right:24px;bottom:24px;width:44px;height:44px;border-radius:50%;background:#333;color:#fff;font-size:22px;text-align:center;line-height:44px;cursor:pointer;opacity:0;transition:opacity .3s;box-shadow:0 2px 8px rgba(0,0,0,.25);z-index:999;user-select:none;\";\n  btn.onmouseover=function(){btn.style.background=\"#555\"};\n  btn.onmouseout=function(){btn.style.background=\"#333\"};\n  btn.onclick=function(){window.scrollTo({top:0,behavior:\"smooth\"})};\n  document.body.appendChild(btn);\n  window.addEventListener(\"scroll\",function(){btn.style.opacity=window.scrollY>300?\"0.85\":\"0\"});\n})();\n</script>\n"
}