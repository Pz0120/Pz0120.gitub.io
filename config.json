{
  "title": "Pz的碎碎念",
  "subTitle": "在坚冰还盖着北海的时候我看到了怒放的梅花",
  "avatarUrl": "https://avatars.githubusercontent.com/u/74855623?v=4&size=64",
  "GMEEK_VERSION": "last",
  "needComment": false,
  "script": "<script>\n(function(){\n  var postBody=document.getElementById(\"postBody\");\n  if(!postBody)return;\n  var text=postBody.innerText||\"\";\n  var count=text.replace(/\\s/g,\"\").length;\n  var minutes=Math.ceil(count/400);\n  var postTitle=document.querySelector(\".postTitle\");\n  if(postTitle && !postTitle.querySelector(\".postDate\")){\n    var dateDiv=document.createElement(\"div\");\n    dateDiv.className=\"postDate\";\n    dateDiv.style.cssText=\"font-size:13px;color:#aaa;font-weight:normal;margin-top:8px;\";\n    dateDiv.innerText=\"发布于 --\";\n    postTitle.appendChild(dateDiv);\n  }\n  var historyDiv=document.createElement(\"div\");\n  historyDiv.style.cssText=\"margin-top:16px;padding:14px 18px;background:#f6f8fa;border-radius:6px;font-size:13px;color:#555;line-height:1.8;\";\n  historyDiv.innerHTML=\"<div style='color:#888;margin-bottom:8px;'>加载中...</div>\";\n  postBody.parentNode.insertBefore(historyDiv,postBody.nextSibling);\n  var div=document.createElement(\"div\");\n  div.style.cssText=\"font-size:13px;color:#888;margin-top:24px;padding-top:12px;border-top:1px solid #eee;text-align:right;\";\n  div.innerText=\"字数统计：\"+count+\" 字 · 预计阅读：\"+minutes+\" 分钟\";\n  postBody.parentNode.insertBefore(div,postBody.nextSibling);\n  var hitokoto=document.createElement(\"div\");\n  hitokoto.style.cssText=\"font-size:13px;color:#999;margin-top:16px;padding:12px 16px;background:#fafafa;border-left:3px solid #ddd;font-style:italic;text-align:center;\";\n  hitokoto.innerText=\"加载中...\";\n  div.parentNode.insertBefore(hitokoto,div.nextSibling);\n  fetch(\"https://v1.hitokoto.cn/?c=d&c=i&encode=json\").then(function(r){return r.json()}).then(function(d){hitokoto.innerHTML=\"「 \"+d.hitokoto+\" 」\"+(d.from?\" —— \"+d.from:\"\")}).catch(function(){hitokoto.innerHTML=\"「 在坚冰还盖着北海的时候，我看到了怒放的梅花 」\"});\n  var issueMatch=window.location.pathname.match(/post\\/(.+)\\.html$/);\n  if(issueMatch){\n    var postListJsonUrl=\"https://raw.githubusercontent.com/Pz0120/pz0120.github.io/main/docs/postList.json\";\n    fetch(postListJsonUrl).then(function(r){return r.json()}).then(function(postList){\n      var postData=null;\n      for(var key in postList){\n        if(postList[key].postUrl===\"post/\"+issueMatch[1]+\".html\"){\n          postData=postList[key];\n          break;\n        }\n      }\n      if(postData){\n        if(postTitle && postTitle.querySelector(\".postDate\")){\n          var createdDate=postData.createdDate||\"--\";\n          postTitle.querySelector(\".postDate\").innerText=\"发布于 \"+createdDate;\n        }\n        if(postData.postSourceUrl){\n          var repoMatch=postData.postSourceUrl.match(/github\\.com\\/([^\\/]+\\/[^\\/]+)\\/issues\\/(\\d+)/);\n          if(repoMatch){\n            var apiUrl=\"https://api.github.com/repos/\"+repoMatch[1]+\"/issues/\"+repoMatch[2]+\"/events?per_page=100\";\n            fetch(apiUrl).then(function(r){return r.json()}).then(function(events){\n              if(!Array.isArray(events)){historyDiv.innerHTML=\"<div style='color:#888;'>暂无编辑记录</div>\";return;}\n              var edits=events.filter(function(e){return e.event===\"edited\"});\n              var created=events.filter(function(e){return e.event===\"opened\"});\n              var createdTime=created.length>0?new Date(created[0].created_at):null;\n              var html=\"<div style='font-weight:600;color:#333;margin-bottom:8px;'>📝 编辑记录</div>\";\n              html+=\"<div>🕐 首次发布：\"+(createdTime?createdTime.toLocaleDateString(\"zh-CN\"):\"--\")+\"</div>\";\n              if(edits.length>0){\n                var lastEdit=new Date(edits[edits.length-1].created_at);\n                html+=\"<div>✏️ 最后编辑：\"+lastEdit.toLocaleDateString(\"zh-CN\")+\" \"+lastEdit.toLocaleTimeString(\"zh-CN\",{hour:\"2-digit\",minute:\"2-digit\"})+\"</div>\";\n                html+=\"<div>📊 编辑次数：\"+edits.length+\" 次</div>\";\n              }else{\n                html+=\"<div style='color:#888;'>本文尚未编辑过</div>\";\n              }\n              historyDiv.innerHTML(html;\n            }).catch(function(){historyDiv.innerHTML=\"<div style='color:#888;'>无法加载编辑记录</div>\"});\n          }\n        }\n      }\n    }).catch(function(){});\n  }\n  var btn=document.createElement(\"div\");\n  btn.innerHTML=\"↑\";\n  btn.style.cssText=\"position:fixed;right:24px;bottom:24px;width:44px;height:44px;border-radius:50%;background:#333;color:#fff;font-size:22px;text-align:center;line-height:44px;cursor:pointer;opacity:0;transition:opacity .3s;box-shadow:0 2px 8px rgba(0,0,0,.25);z-index:999;user-select:none;\";\n  btn.onmouseover=function(){btn.style.background=\"#555\"};\n  btn.onmouseout=function(){btn.style.background=\"#333\"};\n  btn.onclick=function(){window.scrollTo({top:0,behavior:\"smooth\"})};\n  document.body.appendChild(btn);\n  window.addEventListener(\"scroll\",function(){btn.style.opacity=window.scrollY>300?\"0.85\":\"0\"});\n})();\n</script>\n"
}